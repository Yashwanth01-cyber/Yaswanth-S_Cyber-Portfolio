@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 222 47% 7%;
    --foreground: 210 40% 98%;

    --card: 222 42% 10%;
    --card-foreground: 210 40% 98%;

    --popover: 222 42% 10%;
    --popover-foreground: 210 40% 98%;

    --primary: 187 100% 55%;
    --primary-foreground: 222 47% 7%;

    --secondary: 258 90% 66%;
    --secondary-foreground: 210 40% 98%;

    --muted: 222 30% 16%;
    --muted-foreground: 215 20% 70%;

    --accent: 199 95% 60%;
    --accent-foreground: 222 47% 7%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 98%;

    --border: 215 30% 22%;
    --input: 215 30% 22%;
    --ring: 187 100% 55%;

    --radius: 0.85rem;
  }
}

@layer base {
  * {
    @apply border-border;
  }

  html {
    scroll-behavior: smooth;
    background: #07111f;
  }

  body {
    @apply bg-background text-foreground;

    min-height: 100vh;

    background:
      radial-gradient(
        circle at 15% 15%,
        rgba(0, 212, 255, 0.10),
        transparent 28%
      ),
      radial-gradient(
        circle at 85% 20%,
        rgba(139, 92, 246, 0.10),
        transparent 30%
      ),
      radial-gradient(
        circle at 50% 90%,
        rgba(14, 165, 233, 0.06),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        #07111f 0%,
        #0a1424 45%,
        #0b1020 100%
      );

    background-attachment: fixed;

    font-feature-settings: 'rlig' 1, 'calt' 1;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  ::selection {
    background: rgba(34, 211, 238, 0.28);
    color: #ffffff;
  }
}

@layer utilities {
  .glass {
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.075),
        rgba(255, 255, 255, 0.025)
      );

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    border: 1px solid rgba(148, 163, 184, 0.14);

    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .glass-hover {
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .glass-hover:hover {
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.10),
        rgba(255, 255, 255, 0.035)
      );

    border-color: rgba(34, 211, 238, 0.35);

    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.24),
      0 0 30px rgba(34, 211, 238, 0.07);

    transform: translateY(-3px);
  }

  .text-glow {
    text-shadow:
      0 0 12px rgba(34, 211, 238, 0.45),
      0 0 32px rgba(34, 211, 238, 0.18);
  }

  .border-glow {
    box-shadow:
      0 0 24px rgba(34, 211, 238, 0.12),
      inset 0 0 18px rgba(34, 211, 238, 0.025);
  }

  .bg-grid {
    background-image:
      linear-gradient(
        to right,
        rgba(148, 163, 184, 0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        rgba(148, 163, 184, 0.045) 1px,
        transparent 1px
      );

    background-size: 48px 48px;
  }

  .bg-radial-fade {
    background:
      radial-gradient(
        ellipse 80% 55% at 50% -10%,
        rgba(34, 211, 238, 0.12),
        transparent 70%
      );
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  .scrollbar-thin::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.35);
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.25);
    border-radius: 999px;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background: rgba(34, 211, 238, 0.45);
  }
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }

  50% {
    opacity: 0;
  }
}

.animate-blink {
  animation: blink 1s step-end infinite;
}

@keyframes ambientPulse {
  0%, 100% {
    opacity: 0.7;
    transform: scale(1);
  }

  50% {
    opacity: 1;
    transform: scale(1.03);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
